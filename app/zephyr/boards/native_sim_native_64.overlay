/*
 * The desktop program's 800 x 480 development viewport. Not a production
 * display selection.
 */
&sdl_dc {
	width = <800>;
	height = <480>;
};

/*
 * SIMULATION ONLY. The controller link: a host serial device. By default the
 * path tools/controller_link_demo.py links to its pseudo-terminal; another
 * device (a USB serial port) is given with --controller_link_port=<path>. No
 * production link, line or baud rate is implied (ADR-0006).
 */
/ {
	controller_link: controller_link {
		compatible = "zephyr,native-tty-uart";
		status = "okay";
		serial-port = "/tmp/furnace-hmi-controller-link";
		current-speed = <115200>;
	};
};
