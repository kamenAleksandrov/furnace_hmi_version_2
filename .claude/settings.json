{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/delegation/delegation_ceiling.py\" hook",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
